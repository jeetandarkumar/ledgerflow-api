{
  "ConnectionStrings": {
    "DefaultConnection": "Server=Devil-VM;Database=ledgerflowApiDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": ""
  },
  "JwtSettings": {
    "SecretKey": "Q9v!s2Kx#pL8@zW1nR6tY4uI0oP7mA5cB3dE8fG",
    "Issuer": "ledgerflowApiAPI",
    "Audience": "ledgerflowApiClient",
    "ExpirationMinutes": "60",
    "RefreshTokenExpirationDays": "7"
  },
  "Redis": {
    "InstanceName": "ledgerflowApi:"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "ledgerflowApi": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
